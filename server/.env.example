# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.
# 길고 무작위한 문자열. 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 구글 OAuth 클라이언트 ID (공개 값). 비워 두면 구글 로그인이 꺼진다
GOOGLE_CLIENT_ID=
# 화면 주소. 여러 개면 쉼표로
CORS_ORIGIN=http://localhost:5176,https://gkerala.github.io
PORT=3000
# 모든 영웅이 열리는 관리자 아이디. 여러 개면 쉼표로. 비워 두면 관리자가 없다
# 먼저 가입하지 않은 아이디를 적어 두면 다른 사람이 그 아이디로 가입할 수 있으니, 가입한 뒤에 적는다
ADMIN_USERNAMES=
